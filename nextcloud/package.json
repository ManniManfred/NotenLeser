{
  "name": "notenleser-nextcloud",
  "version": "0.3.2",
  "private": true,
  "description": "NotenLeser as a Nextcloud app",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.js",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "package": "node scripts/build.mjs && sh scripts/package.sh"
  },
  "dependencies": {
